{
  "name": "react-native-fabric-rich-text-e2e",
  "version": "0.0.1",
  "private": true,
  "description": "End-to-end tests for react-native-fabric-rich-text iOS",
  "scripts": {
    "build": "./scripts/build-ios.sh",
    "build:device": "./scripts/build-ios.sh",
    "test": "wdio run wdio.conf.ts",
    "test:ci": "./scripts/build-ios.sh && wdio run wdio.conf.ts --bail 1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf .appium && echo 'E2E build artifacts cleaned'"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@wdio/appium-service": "^9.27.0",
    "@wdio/cli": "^9.27.0",
    "@wdio/local-runner": "^9.27.0",
    "@wdio/mocha-framework": "^9.27.0",
    "@wdio/spec-reporter": "^9.27.0",
    "appium": "^3.3.1",
    "appium-xcuitest-driver": "^10.14.2",
    "eslint": "^9.28.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2"
  }
}
